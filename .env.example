# Copy this file to .env and fill in the empty values:
#   cp .env.example .env
# The .env file is listed in .gitignore and must never be committed.
# Docker Compose reads it automatically.

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
# Use letters and digits only (the password is placed inside the connection URL)
POSTGRES_PASSWORD=
POSTGRES_DB=textprocessing

# --- Backend ---
# Secret used to sign JWT tokens. Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
